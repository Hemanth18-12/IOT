# Server
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
# Comma-separated allowed CORS origins (add LAN IP for mobile browser testing, e.g. http://192.168.1.25:5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (sqlite by default; set DB_TYPE=postgres and DATABASE_URL for PostgreSQL)
DB_TYPE=sqlite
DB_PATH=./data/smartroom.sqlite
DATABASE_URL=
DB_SYNCHRONIZE=false
DB_RUN_MIGRATIONS=true

# JWT Authentication (CHANGE THESE BEFORE RUNNING)
JWT_SECRET=replace-with-a-long-random-64-char-secret-string
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=30d

# Initial Admin Seed Account (run `npm run seed:admin` after setting these)
ADMIN_NAME=SmartRoom Admin
ADMIN_EMAIL=admin@smartroom.local
ADMIN_PASSWORD=ChangeMeStrongPassword123!

# Default Hardware Device
DEFAULT_DEVICE_ID=smartroom-01
DEFAULT_DEVICE_NAME=SmartRoom Primary Node

# MQTT Broker Connection
MQTT_ENABLED=true
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=smartroom_backend
MQTT_PASSWORD=replace-with-mqtt-backend-password
MQTT_CLIENT_ID=smartroom-backend-service
# Optional TLS settings (for mqtts:// on port 8883)
MQTT_CA_PATH=
MQTT_REJECT_UNAUTHORIZED=true

# Telemetry Sampling & Retention
TELEMETRY_SAMPLE_INTERVAL_MS=10000
TELEMETRY_RETENTION_DAYS=30
STALE_TELEMETRY_SECONDS=20
DEVICE_OFFLINE_THRESHOLD_SECONDS=25
COMMAND_TIMEOUT_MS=12000

# SMTP Email Notifications (Gmail STARTTLS Example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=MY_GMAIL_ADDRESS
SMTP_PASS=MY_GOOGLE_APP_PASSWORD
EMAIL_FROM=MY_GMAIL_ADDRESS
DEFAULT_ALERT_EMAIL=MY_RECIPIENT_EMAIL
DASHBOARD_PUBLIC_URL=http://localhost:5173
EMAIL_RETRY_LIMIT=2
ALLOW_SIMULATOR_EMAILS=false
