# Leave empty to automatically use Vite dev proxy (/api and /socket.io) on desktop & mobile LAN,
# or set explicitly when deploying frontend separately from backend (e.g. http://192.168.1.25:3000).
VITE_API_URL=
VITE_SOCKET_URL=
VITE_DEFAULT_DEVICE_ID=smartroom-01
# Set to "true" only if you explicitly want to allow enabling the Demo Mode toggle in the UI.
VITE_ENABLE_DEMO_MODE=true
