# DO NOT USE THESE PLACEHOLDERS IN PRODUCTION.
# Generate real hashed passwords using Mosquitto:
#   mosquitto_passwd -c -b mqtt/passwords smartroom_backend CHANGE_ME_BACKEND_PASS
#   mosquitto_passwd -b mqtt/passwords smartroom_device CHANGE_ME_DEVICE_PASS
#
# Expected usernames matching mqtt/acl.conf:
smartroom_backend:REPLACE_WITH_MOSQUITTO_PASSWD_HASH
smartroom_device:REPLACE_WITH_MOSQUITTO_PASSWD_HASH
